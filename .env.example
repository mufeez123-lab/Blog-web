# ============================================================================
# TECHLEDGER ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to version control.
# ============================================================================

# 1. MongoDB Atlas Connection String (Server-Only)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/techledger?retryWrites=true&w=majority
# Leave empty in local dev if you want to preview using fallback demonstration data.
MONGODB_URI=

# 2. Session & Authentication Secret (Server-Only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters in production.
SESSION_SECRET=replace_with_at_least_32_characters_random_hex_secret_key

# 3. Public Canonical Site URL (Browser-Safe)
# Used for canonical links, Open Graph tags, XML sitemaps, and Schema.org JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Google AdSense Configuration (Set only after official site approval)
# Example format: ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ENABLE_ADS=false

# 5. Optional Analytics & Search Console Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# 6. Optional Image Storage Configuration (JSON or URL string for external CDN/Cloudinary, or local /uploads in dev)
IMAGE_STORAGE_CONFIGURATION={"provider":"local","maxFileSizeBytes":2097152}

# 7. Optional Maintenance Mode Toggle ("true" or "false")
MAINTENANCE_MODE=false

# 8. Initial Admin Bootstrap Credentials (Used ONLY by scripts/create-admin.ts, never hardcoded in app)
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# 9. Cron Secret for Scheduled Article Publishing Endpoint (/api/cron/publish-scheduled)
CRON_SECRET=
